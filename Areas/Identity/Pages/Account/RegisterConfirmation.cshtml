@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmação de Registro";
}

<div class="register-card">
    <h2>@ViewData["Title"]</h2>
    @{
        if (Model.DisplayConfirmAccountLink)
        {
            <p>
                Este aplicativo não possui atualmente um remetente de e-mail real registrado, veja
                <a href="https://aka.ms/aspaccountconf" target="_blank" rel="noopener noreferrer">estes documentos</a> para saber como configurar um remetente de e-mail real.
            </p>
            <a class="btn-register" id="confirm-link" href="@Model.EmailConfirmationUrl">Clique aqui para confirmar sua conta</a>
        }
        else
        {
            <p>Por favor, verifique seu e-mail para confirmar sua conta.</p>
        }
    }
</div>
