@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Reenviar confirmação por e-mail.";
}

<div class="container d-flex justify-content-center align-items-center" ">
    <div class="col-md-4">
        <h2 class="text-center fw-bold">@ViewData["Title"]</h2>
        <h4 class="text-center display-8">Insira seu e-mail.</h4>
        <hr />
        <form method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email" class="form-label"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-secondary">Reenviar</button>
        </form>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}
