@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="card shadow-lg border-0" style="background-color: #ffe8cd; border-radius: 16px; max-width: 500px; width: 100%; box-shadow: -8px 0 20px rgba(192, 101, 0, 0.4);">
        <div class="card-body p-5">
            <h2 class="text-center mb-4 text-black fw-bold">Acesse sua conta</h2>
            <form id="account" method="post" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="email@example.com" />
                    <label asp-for="Input.Email">E-mail</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="••••••" />
                    <label asp-for="Input.Password">Senha</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">Lembrar-me</label>
                </div>

                <div class="d-grid">
                    <button id="login-submit" type="submit" class="btn btn-lg" style="background-color:#C06500; color:white; font-weight:600;">
                        Entrar
                    </button>
                </div>

                <hr class="my-4" />
                <div class="text-center">
                    <a asp-page="./ForgotPassword" class="btn btn-outline-secondary w-100 mb-2">Esqueceu sua senha?</a>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-outline-secondary w-100 mb-2">Registrar novo usuário</a>
                    <a asp-page="./ResendEmailConfirmation" class="btn btn-outline-secondary w-100">Reenviar confirmação por e-mail</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
    <partial name="_ValidationScriptsPartial" />
}
