@page
@model LoginModel
@{
    ViewData["Title"] = "Entrar - Focinhos Felizes";
}

<link rel="stylesheet" href="~/css/login.css" />

<div class="d-flex justify-content-center align-items-center vh-100 login-background">
    <div class="login-card">
        <div class="text-center mb-4">
            <img src="~/images/logo.png" alt="Logo Focinhos Felizes" class="login-logo">
            <h2 class="fw-bold mt-3">Bem-vindo de volta!</h2>
            <p class="text-muted mb-0">Acesse sua conta e continue ajudando<br>a transformar vidas!</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label fw-semibold">E-mail</label>
                <input asp-for="Input.Email" class="form-control p-2" placeholder="Seu e-mail" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label fw-semibold">Senha</label>
                <input asp-for="Input.Password" class="form-control p-2" placeholder="Sua senha" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe">Lembrar-me</label>
            </div>

            <button id="login-submit" type="submit" class="btn w-100 login-btn">Entrar</button>

            <div class="text-center mt-3">
                <a asp-page="./ForgotPassword" class="d-block">Esqueceu sua senha?</a>
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="d-block">Criar nova conta</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
