@model IEnumerable<FocinhosFelizes1.Models.RegistroDoacao>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Produtos)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DoadoresId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ValidadeProduto)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataDoacao)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Produtos.ProdutosId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DoadoresId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ValidadeProduto)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataDoacao)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.RegistroDoacaoId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.RegistroDoacaoId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.RegistroDoacaoId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
