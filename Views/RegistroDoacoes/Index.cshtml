@model IEnumerable<FocinhosFelizes1.Models.RegistroDoacao>

@{
    ViewData["Title"] = "Registro de Doações";
}

<h1 class="fw-bold text-center">Registro de Doações</h1>

<p>
    <a asp-action="Create" class="btn btn-secondary ">Adicionar</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Produtos)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Doador)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ValidadeProduto)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataDoacao)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Produtos.ProdutosId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DoadoresId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ValidadeProduto)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataDoacao)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.RegistroDoacaoId" class="btn btn-secondary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.RegistroDoacaoId" class="btn btn-secondary">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
