@model FocinhosFelizes1.Models.RegistroDoacao

@{
    ViewData["Title"] = "Excluir Registro de Doação";
}

<div class="container py-5 my-5 d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="card-categorias shadow w-100" style="max-width: 750px; padding: 40px; border-radius: 16px; border: 2px solid #C48A5A; background-color: #FFF5EB;">

        <h1 class="text-center fw-bold mb-4" style="color: #8C5E3C; letter-spacing: 0.5px;">
            Excluir Registro de Doação
        </h1>

        <hr style="border-top: 3px solid #C48A5A; border-radius: 10px;" />

        <h3 class="text-center mb-4">
            Tem certeza que deseja <strong>excluir</strong> este registro de doação?
        </h3>

        <dl class="row mb-4">
            <dt class="col-sm-4 fs-5 fw-semibold" style="color:#5A4330;">Produto</dt>
            <dd class="col-sm-8 fs-5">@Html.DisplayFor(model => model.Produtos.NomeCategoria)</dd>

            <dt class="col-sm-4 fs-5 fw-semibold" style="color:#5A4330;">Doador</dt>
            <dd class="col-sm-8 fs-5">@Html.DisplayFor(model => model.Doador.NomeDoador)</dd>

            <dt class="col-sm-4 fs-5 fw-semibold" style="color:#5A4330;">Validade</dt>
            <dd class="col-sm-8 fs-5">@Html.DisplayFor(model => model.ValidadeProduto)</dd>

            <dt class="col-sm-4 fs-5 fw-semibold" style="color:#5A4330;">Data da Doação</dt>
            <dd class="col-sm-8 fs-5">@Html.DisplayFor(model => model.DataDoacao)</dd>
        </dl>

        <div class="row g-3 justify-content-between">
            <div class="col-lg-4 col-md-6 col-12">
                <a asp-action="Index"
                   class="btn w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2"
                   style="background-color:#C48A5A; color:white; border-radius: 12px; box-shadow:0 4px 12px rgba(92,48,20,0.3);">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>
            </div>

            <div class="col-lg-4 col-md-6 col-12">
                <form asp-action="Delete" method="post" class="mb-0">
                    <input type="hidden" asp-for="RegistroDoacaoId" />
                    <button type="submit"
                            class="btn w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2"
                            style="background-color:#8C5E3C; color:white; border-radius: 12px; box-shadow:0 4px 12px rgba(92,48,20,0.4);">
                        <i class="bi bi-trash3"></i> Excluir
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>