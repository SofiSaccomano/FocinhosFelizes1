@model FocinhosFelizes1.Models.RegistroDoacao

@{
    ViewData["Title"] = "Delete";
}

<h1>Excluir</h1>

<h3>Você realmente deseja excluir isso?</h3>
<div>
    <h4>RegistroDoacao</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Produtos)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Produtos.ProdutosId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DoadoresId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DoadoresId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ValidadeProduto)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ValidadeProduto)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DataDoacao)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DataDoacao)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="RegistroDoacaoId" />
        <input type="submit" value="Excluir" class="btn btn-secondary" /> 
