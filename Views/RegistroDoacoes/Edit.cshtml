@model FocinhosFelizes1.Models.RegistroDoacao

@{
    ViewData["Title"] = "Edit";
}


<h2 class="display-6 text-center">Editar Registro de Doações</h2>
<hr />

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="RegistroDoacaoId" />
    <div class="row">
        <div class="col-12 col-lg-6">
            <div class="form-group">
                <label asp-for="ProdutosId" class="control-label"></label>
                <select asp-for="ProdutosId" class="form-control" asp-items="ViewBag.ProdutosId"></select>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="form-group">
                <label asp-for="DoadorId" class="control-label"></label>
                <input asp-for="DoadorId" class="form-control" />
                <span asp-validation-for="DoadorId" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12 col-lg-6">
            <div class="form-group">
                <label asp-for="ValidadeProduto" class="control-label"></label>
                <input asp-for="ValidadeProduto" class="form-control" />
                <span asp-validation-for="ValidadeProduto" class="text-danger"></span>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="form-group">
                <label asp-for="DataDoacao" class="control-label"></label>
                <input asp-for="DataDoacao" class="form-control" />
                <span asp-validation-for="DataDoacao" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-6 mt-3">
            <div class="form-group">
                <button type="submit" class="btn btn-primary w-100 p-2 ">Salvar</button>
            </div>
        </div>

        <div class="col-6 mt-3">
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary w-100 p-2"> Voltar</a>
            </div>
        </div>
    </div>
</form>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
