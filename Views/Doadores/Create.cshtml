@model FocinhosFelizes1.Models.Doador

@{
    ViewData["Title"] = "Create";
}

<h2 class="display-6 text-center">Cadastro de Doadores</h2>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-12 ">
            <div class="form-group">
                <label asp-for="NomeDoador" class="control-label"></label>
                <input asp-for="NomeDoador" class="form-control" />
                <span asp-validation-for="NomeDoador" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12 col-lg-6">
            <div class="form-group">
                <label asp-for="CPF" class="control-label"></label>
                <input asp-for="CPF" class="form-control" />
                <span asp-validation-for="CPF" class="text-danger"></span>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="form-group">
                <label asp-for="Celular" class="control-label"></label>
                <input asp-for="Celular" class="form-control" />
                <span asp-validation-for="Celular" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-6 mt-3">
            <div class="form-group">
                <button type="submit" class="btn btn-secondary w-100 p-2 ">Salvar</button>
            </div>
        </div>

        <div class="col-6 mt-3">
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary w-100 p-2"> Voltar</a>
            </div>
        </div>
    </div>


</form>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
