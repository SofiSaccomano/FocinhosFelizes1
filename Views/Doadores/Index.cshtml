@model IEnumerable<FocinhosFelizes1.Models.Doador>

@{
    ViewData["Title"] = "Doadores";
}

<h1 class="fw-bold text-center">Doadores</h1>

<div class="row mt-5 mb-3">
    <div class="col-3">
        <a asp-action="Create" class="btn btn-secondary ">Adicionar</a>
    </div>
    <div class="col-9">
        <!-- Campo de Busca -->
        <form asp-action="Search" method="get" class="mb-3">
            <div class="input-group">
                <input type="text" name="searchTerm" class="form-control" placeholder="Buscar por nome ou CPF..." />
                <button type="submit" class="btn btn-secondary"> Buscar</button>
            </div>
        </form>
    </div>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NomeDoador)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CPF)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Celular)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.NomeDoador)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CPF)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Celular)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.DoadorId" class="btn btn-secondary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.DoadorId" class="btn btn-secondary">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
