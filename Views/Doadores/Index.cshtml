@model IEnumerable<FocinhosFelizes1.Models.Doador>

@{
    ViewData["Title"] = "Doadores";
}

<div class="container py-5" style="min-height: 70vh;">
    <div class="card-categorias shadow p-4">

        <h1 class="text-center fw-bold mb-4" style="color: var(--laranja-medio);">
            Doadores
        </h1>

        <!-- Ações superiores -->
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
            <a asp-action="Create" class="btn btn-laranja btn-lg px-4 d-flex align-items-center">
                <i class="bi bi-plus-circle me-2"></i> Adicionar
            </a>

            <form asp-action="Search" method="get" class="flex-grow-1">
                <div class="input-group input-group-lg">
                    <input type="text" name="searchTerm" class="form-control" placeholder="Buscar por nome ou CPF..." />
                    <button type="submit" class="btn btn-laranja">
                        <i class="bi bi-search me-1"></i> Buscar
                    </button>
                </div>
            </form>
        </div>

        <!-- Tabela -->
        <div class="table-responsive">
            <table class="table table-hover align-middle text-center">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>CPF</th>
                        <th>Celular</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.NomeDoador</td>
                            <td>@item.CPF</td>
                            <td>@item.Celular</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.DoadorId" class="btn-acao me-3">
                                    <i class="bi bi-pencil-square fs-5"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.DoadorId" class="btn-acao">
                                    <i class="bi bi-trash3 fs-5"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

