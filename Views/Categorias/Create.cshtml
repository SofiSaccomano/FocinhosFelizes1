@model FocinhosFelizes1.Models.Categoria

@{
    ViewData["Title"] = "Criar Categoria";
}

<div class="container py-5 my-5 d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="form-card w-100" style="max-width: 700px; background-color:#ffe8cd; box-shadow: 0 8px 20px rgba(210, 115, 0, 0.25); padding: 40px; border-radius: 15px;">
        <h1 class="text-center fw-bold mb-4" style="color:#d27300; letter-spacing: 1px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
            Criar Nova Categoria
        </h1>
        <hr style="border-top: 3px solid #d27300; border-radius: 10px;" />

        <form asp-action="Create" class="text-dark needs-validation" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row mb-4">
                <div class="col-12 col-lg-6 mb-3 mb-lg-0">
                    <label asp-for="TipoCategoria" class="form-label fw-semibold" style="color:#a85e00;">Tipo de Categoria</label>
                    <input asp-for="TipoCategoria"
                           class="form-control form-control-lg"
                           style="border: 2px solid #d27300; border-radius: 12px; background-color: #fff7eb; color: #5c3a00;"
                           placeholder="Digite o tipo da categoria" required />
                    <div class="invalid-feedback">Por favor, informe o tipo da categoria.</div>
                    <span asp-validation-for="TipoCategoria" class="text-danger"></span>
                </div>
                <div class="col-12 col-lg-6">
                    <label asp-for="DescricaoCategoria" class="form-label fw-semibold" style="color:#a85e00;">Descrição</label>
                    <input asp-for="DescricaoCategoria"
                           class="form-control form-control-lg"
                           style="border: 2px solid #d27300; border-radius: 12px; background-color: #fff7eb; color: #5c3a00;"
                           placeholder="Descreva a categoria" required />
                    <div class="invalid-feedback">Por favor, insira a descrição da categoria.</div>
                    <span asp-validation-for="DescricaoCategoria" class="text-danger"></span>
                </div>
            </div>

            <div class="row gap-3 d-flex justify-content-between">
                <div class="col-lg-4 col-md-6 col-12">
                    <button type="submit"
                            class=" btn btn-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-2"
                            style=" border-radius: 12px; font-weight: 600; box-shadow: 0 4px 12px rgba(108, 117, 125, 0.5); transition: background-color 0.3s ease;">
                        <i class="bi bi-check2-circle"></i> Salvar
                    </button>
                </div>
                <div class="col-lg-4 col-md-6 col-12">
                    <a asp-action="Index"
                       class="btn btn-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-2"
                       style=" border-radius: 12px; font-weight: 600; transition: background-color 0.3s ease;">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>

    @await Html.PartialAsync("_ValidationScriptsPartial")
}
