@model IEnumerable<FocinhosFelizes1.Models.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<h1 class="fw-bold text-center">Categorias</h1>

<div class="col-3">
    <a asp-action="Create" class="btn btn-secondary ">Adicionar</a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TipoCategoria)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DescricaoCategoria)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.TipoCategoria)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DescricaoCategoria)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.CategoriaId" class="btn btn-secondary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.CategoriaId" class="btn btn-secondary">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
