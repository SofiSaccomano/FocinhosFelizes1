@model FocinhosFelizes1.Models.Categoria

@{
    ViewData["Title"] = "Delete";
}

<h1>Excluir</h1>

<h3>Tem certeza que quer excluir isso?</h3>
<div>
    <h4>Categoria</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TipoCategoria)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TipoCategoria)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DescricaoCategoria)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DescricaoCategoria)
        </dd>
    </dl>

    <form asp-action="Deletar">
        <input type="hidden" asp-for="CategoriaId" />
        <input type="submit" value="Delete" class="btn btn btn-secondary" />
        <a asp-action="Index" class="btn btn-secondary">Voltar para a lista</a>
    </form>
</div>
