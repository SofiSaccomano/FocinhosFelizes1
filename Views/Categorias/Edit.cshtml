@model FocinhosFelizes1.Models.Categoria

@{
    ViewData["Title"] = "Edit";
}

<h2 class="display-6 text-center">Editar Categorias</h2>
<hr />

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="CategoriaId" />


    <div class="row">
        <div class="col-12 col-lg-6">
            <div class="form-group">
                <label asp-for="TipoCategoria" class="control-label"></label>
                <input asp-for="TipoCategoria" class="form-control" />
                <span asp-validation-for="TipoCategoria" class="text-danger"></span>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="form-group">
                <label asp-for="DescricaoCategoria" class="control-label"></label>
                <input asp-for="DescricaoCategoria" class="form-control" />
                <span asp-validation-for="DescricaoCategoria" class="text-danger"></span>
            </div>
        </div>

    </div>

    <div class="row">
        <div class="col-6 mt-3">
            <div class="form-group">
                <button type="submit" class="btn btn-primary w-100 p-2 "><i class="bi bi-floppy"></i>Salvar</button>
            </div>
        </div>

        <div class="col-6 mt-3">
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary w-100 p-2"><i class="bi bi-arrow-clockwise"></i> Voltar</a>
            </div>
        </div>
    </div>
</form>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
