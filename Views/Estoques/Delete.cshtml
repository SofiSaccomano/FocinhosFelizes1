@model FocinhosFelizes1.Models.Estoque

@{
    ViewData["Title"] = "Excluir Estoque";
}

<div class="container py-5 my-5 d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="card shadow-lg w-100" style="max-width: 700px; background-color:#ffe8cd; border-radius: 15px;">

        <!-- Cabeçalho -->
        <div class="card-header text-center border-0" style="background-color:#d27300; border-top-left-radius:15px; border-top-right-radius:15px;">
            <h1 class="mb-0 text-light fw-bold">Excluir Estoque</h1>
        </div>

        <!-- Corpo -->
        <div class="card-body">
            <h4 class="text-center mb-4">
                Tem certeza que deseja <strong>excluir</strong> este item do estoque?
            </h4>

            <dl class="row fs-5">
                <dt class="col-sm-4 fw-semibold">Produto</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Produtos.NomeCategoria)</dd>

                <dt class="col-sm-4 fw-semibold">Quantidade</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.QtdEstoque)</dd>
            </dl>
        </div>

        <!-- Rodapé -->
        <div class="card-footer bg-transparent d-flex gap-3 justify-content-between">
            <a asp-action="Index"
               class="btn btn-outline-secondary w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2"
               style="border-radius:12px;">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
            <form asp-action="Delete" method="post" class="w-100 mb-0">
                <input type="hidden" asp-for="EstoqueId" />
                <button type="submit"
                        class="btn btn-secondary w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2"
                        style="border-radius:12px;">
                    <i class="bi bi-trash3"></i> Excluir
                </button>
            </form>
        </div>

    </div>
</div>
