@model FocinhosFelizes1.Models.Estoque

@{
    ViewData["Title"] = "Excluir";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Card principal -->
            <div class="card shadow-lg border-0" style="background-color:#ffe8cd">

                <!-- Cabeçalho -->
                <div class="card-header text-center border-0" style="background-color:#D27300">
                    <h1 class="mb-0 text-light">Excluir Estoque</h1>
                </div>

                <!-- Corpo -->
                <div class="card-body">
                    <h3 class="text-center mb-4">
                        Tem certeza que deseja <strong>excluir</strong> este item do estoque?
                    </h3>

                    <dl class="row">
                        <dt class="col-sm-4 fs-5">Produto</dt>
                        <dd class="col-sm-8 mb-3 fs-5">
                            @Html.DisplayFor(model => model.Produtos.NomeCategoria)
                        </dd>

                        <dt class="col-sm-4 fs-5">Quantidade</dt>
                        <dd class="col-sm-8 mb-3 fs-5">
                            @Html.DisplayFor(model => model.QtdEstoque)
                        </dd>
                    </dl>
                </div>

                <!-- Rodapé com botões -->
                <div class="card-footer bg-transparent d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary btn-lg text-light">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </a>
                    <form asp-action="Delete" method="post" class="mb-0">
                        <input type="hidden" asp-for="EstoqueId" />
                        <button type="submit" class="btn btn-secondary btn-lg text-light">
                            <i class="bi bi-trash3"></i> Excluir
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
