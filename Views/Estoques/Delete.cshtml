@model FocinhosFelizes1.Models.Estoque

@{
    ViewData["Title"] = "Delete";
}

<h1>Excluir</h1>

<h3>Você realmente deseja excluir isso?</h3>
<div>
    <h4>Estoque</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Produtos)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Produtos.NomeCategoria)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.QtdEstoque)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.QtdEstoque)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="EstoqueId" />
        <input type="submit" value="Excluir" class="btn btn-secondary" />
        <a asp-action="Index" class="btn btn-secondary">Voltar para a lista</a>
    </form>
</div>
