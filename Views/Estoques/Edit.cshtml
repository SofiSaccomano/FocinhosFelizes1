@model FocinhosFelizes1.Models.Estoque

@{
    ViewData["Title"] = "Edit";
}

<h2 class="display-6 text-center">Editar Estoque</h2>
<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="EstoqueId" />
    <div class="row">
        <div class="col-12 col-lg-6">
            <div class="form-group">
                <label asp-for="ProdutosId" class="control-label"></label>
                <select asp-for="ProdutosId" class="form-control" asp-items="ViewBag.ProdutosId"></select>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="form-group">
                <label asp-for="QtdEstoque" class="control-label"></label>
                <input asp-for="QtdEstoque" class="form-control" />
                <span asp-validation-for="QtdEstoque" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-6 mt-3">
                <div class="form-group">
                    <button type="submit" class="btn btn-primary w-100 p-2 ">Salvar</button>
                </div>
            </div>

            <div class="col-6 mt-3">
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 p-2">Voltar</a>
                </div>
            </div>
        </div>

    </div>
</form>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
