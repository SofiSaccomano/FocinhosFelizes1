@model IEnumerable<FocinhosFelizes1.Models.Produtos>

@{
    ViewData["Title"] = "Produtos";
}

<h1 class="fw-bold text-center">Produtos</h1>

<p>
    <a asp-action="Create" class="btn btn-secondary ">Adicionar</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NomeCategoria)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Categoria)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DescricaoProduto)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.NomeCategoria)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Categoria.TipoCategoria)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DescricaoProduto)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProdutosId" class="btn btn-secondary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.ProdutosId" class="btn btn-secondary">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
