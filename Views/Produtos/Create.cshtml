@model FocinhosFelizes1.Models.Produtos

@{
    ViewData["Title"] = "Create";
}

<h2 class="display-6 text-center">Produtos</h2>
<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-12 col-lg-6">
            <div class="form-group">
                <label asp-for="NomeCategoria" class="control-label"></label>
                <input asp-for="NomeCategoria" class="form-control" />
                <span asp-validation-for="NomeCategoria" class="text-danger"></span>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="form-group">
                <label asp-for="CategoriaId" class="control-label"></label>
                <select asp-for="CategoriaId" class="form-control" asp-items="ViewBag.CategoriaId"></select>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="form-group">
                <label asp-for="DescricaoProduto" class="control-label"></label>
                <input asp-for="DescricaoProduto" class="form-control" />
                <span asp-validation-for="DescricaoProduto" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-6 mt-3">
            <div class="form-group">
                <button type="submit" class="btn btn-secondary w-100 p-2 "><i class="bi bi-floppy"></i>Salvar</button>
            </div>
        </div>

        <div class="col-6 mt-3">
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary w-100 p-2"><i class="bi bi-arrow-clockwise"></i> Voltar</a>
            </div>
        </div>
    </div>
    </div>
</form>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
